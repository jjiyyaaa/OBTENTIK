# Private key for deploying to Polygon Amoy Testnet (DO NOT COMMIT REAL PRIVATE KEYS)
PRIVATE_KEY=your_private_key_without_0x_prefix

# Polygon Amoy RPC URL (Default public RPC or Alchemy / Infura / Drpc endpoint)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Optional: Polygonscan API key for contract verification on Amoy
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Optional: Initial Whitelisted Addresses (Used during deployment)
INITIAL_MANUFACTURER_ADDRESS=
INITIAL_MANUFACTURER_NAME=PT Kimia Farma Tbk

INITIAL_DISTRIBUTOR_ADDRESS=
INITIAL_DISTRIBUTOR_NAME=PT Kimia Farma Trading & Distribution

INITIAL_PHARMACY_ADDRESS=
INITIAL_PHARMACY_NAME=Apotek K-24 Senopati
